#!/usr/bin/env bash
# Pre-push gate. Runs in order:
#   1. tsc --noEmit         (matches Vercel prebuild)
#   2. npm run test:contracts (the regression-proof smoke suite)
#
# Per agreement with the user (2026-05-28): both checks are STRICT.
# Bypass an individual stage with SKIP_TSC=1 or SKIP_TESTS=1, or both with
# SKIP_ALL=1. Bypass should be rare and noted in the commit message.
set -e

if [ "${SKIP_ALL:-0}" = "1" ]; then
  echo "[pre-push] SKIP_ALL=1 — skipping ALL pre-push checks"
  exit 0
fi

# (0/2) Dependency vulnerability gate — high+ severity in runtime deps blocks.
# [S0.1] Added 2026-06-10 as part of the product quality audit.
if [ "${SKIP_AUDIT:-0}" = "1" ]; then
  echo "[pre-push] SKIP_AUDIT=1 — skipping npm audit gate"
else
  echo "[pre-push] (0/2) npm audit (high+ severity, runtime deps)..."
  if ! npm audit --omit=dev --audit-level=high >/dev/null 2>&1; then
    echo "[pre-push] FAILED: high-severity dependency vulnerability — push BLOCKED."
    echo "[pre-push] Run 'npm audit' for details, or bypass with: SKIP_AUDIT=1 git push"
    exit 1
  fi
fi

if [ "${SKIP_TSC:-0}" = "1" ]; then
  echo "[pre-push] SKIP_TSC=1 set — skipping tsc --noEmit"
else
  echo "[pre-push] (1/2) Running tsc --noEmit (matches Vercel prebuild)..."
  if ! npx --no-install tsc --noEmit; then
    echo ""
    echo "[pre-push] FAILED: TypeScript errors detected — push BLOCKED."
    echo "[pre-push] Fix the errors above, or bypass with: SKIP_TSC=1 git push"
    exit 1
  fi
  echo "[pre-push] (1/2) tsc clean."
fi

if [ "${SKIP_TESTS:-0}" = "1" ]; then
  echo "[pre-push] SKIP_TESTS=1 set — skipping contract suite (USE SPARINGLY)"
else
  echo "[pre-push] (2/2) Running regression contract suite..."
  echo "[pre-push]       (smoke account: portol-smoke@aol.com — ~60-120s)"
  if ! npm run --silent test:contracts; then
    echo ""
    echo "[pre-push] FAILED: contract suite failed — push BLOCKED."
    echo "[pre-push] If a failing test is expected because you intentionally"
    echo "[pre-push] changed a documented contract, update the test alongside"
    echo "[pre-push] the code in the same commit. Do NOT bypass without cause."
    echo "[pre-push] Emergency bypass: SKIP_TESTS=1 git push"
    exit 1
  fi
  echo "[pre-push] (2/2) Contracts passing."
fi

echo "[pre-push] All checks passed — push allowed."
exit 0
